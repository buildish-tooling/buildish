{
  "name": "cache-gradle",
  "version": "0.0.0-development",
  "scripts": {
    "test": "vitest run",
    "clean": "node -e \"for (const path of [\\\"dist\\\",\\\"coverage\\\"]) { require(\\\"fs\\\").rmSync(path, { recursive: true, force: true }); }\"",
    "compile": "tsc -p tsconfig.json --noEmit",
    "bundle": "npm run bundle:main && npm run bundle:post",
    "bundle:main": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/main/index.cjs",
    "bundle:post": "esbuild src/post.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/post/index.cjs",
    "build": "npm run compile && npm run bundle",
    "rebuild": "npm run clean && npm run build",
    "smoke-test": "node scripts/smoke-test.mjs",
    "benchmark:manifest": "esbuild test/bench/manifest-benchmark.ts --bundle --platform=node --target=node24 --format=esm --outfile=build/manifest-benchmark.mjs && node --expose-gc build/manifest-benchmark.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "rat-check": "node scripts/rat-check.mjs",
    "verify": "npm run lint && npm run format && npm run test && npm run rebuild"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "description": "GitHub Action for secure Gradle wrapper provisioning and Gradle cache management.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@actions/cache": "6.0.0",
    "@actions/core": "3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.5.0",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "esbuild": "0.27.4",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.1"
  }
}
