ARG SITE_PIPELINE_BASE_IMAGE=localhost/buildish-site-pipeline:local

FROM ${SITE_PIPELINE_BASE_IMAGE}

ARG NODE_VERSION=24.13.0
ARG NODE_SHA256_AMD64=e798599612f4bb71333a3397ab0d095fd62214e115aea45aa858a145fc72d67e
ARG NODE_SHA256_ARM64=aa881151bd0f9f154a0424dd60a72e9ce10672619121658c278a24327ef46831
ARG GO_VERSION=1.26.1
ARG GO_SHA256_AMD64=031f088e5d955bab8657ede27ad4e3bc5b7c1ba281f05f245bcc304f327c987a
ARG GO_SHA256_ARM64=a290581cfe4fe28ddd737dde3095f3dbeb7f2e4065cab4eae44dfc53b760c2f7
ARG HUGO_VERSION=0.162.1
ARG HUGO_SHA256_AMD64=e34160095b6a6406af857fe212f50e4451f67ed1276b9bb0de13d08754980118
ARG HUGO_SHA256_ARM64=f5531494dd573cfc142779894a9e3e414ab05626d6e0492cc06209dc783aaf39

USER root

RUN set -eux; \
    : "Install base OS packages required by the derived site builder."; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl git make xz-utils; \
    rm -rf /var/lib/apt/lists/*; \
    : "Resolve architecture-specific download targets and checksums."; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) node_arch='x64'; node_sha="$NODE_SHA256_AMD64"; go_arch='amd64'; go_sha="$GO_SHA256_AMD64"; hugo_arch='amd64'; hugo_sha="$HUGO_SHA256_AMD64" ;; \
      arm64) node_arch='arm64'; node_sha="$NODE_SHA256_ARM64"; go_arch='arm64'; go_sha="$GO_SHA256_ARM64"; hugo_arch='arm64'; hugo_sha="$HUGO_SHA256_ARM64" ;; \
      *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    : "Install Node.js."; \
    curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    echo "${node_sha}  /tmp/node.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    : "Install Go."; \
    curl -fsSLo /tmp/go.tar.gz "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz"; \
    echo "${go_sha}  /tmp/go.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/go.tar.gz -C /usr/local; \
    ln -sf /usr/local/go/bin/go /usr/local/bin/go; \
    ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt; \
    rm -f /tmp/go.tar.gz; \
    : "Install Hugo."; \
    curl -fsSLo /tmp/hugo.tar.gz "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-${hugo_arch}.tar.gz"; \
    echo "${hugo_sha}  /tmp/hugo.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/hugo.tar.gz -C /usr/local/bin hugo; \
    rm -f /tmp/hugo.tar.gz; \
    : "Verify the derived site builder toolchain."; \
    node --version; npm --version; go version; hugo version; uv --version

USER site-pipeline

ENTRYPOINT []
CMD ["bash"]

WORKDIR /workspace/site
