{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "group:monorepos",
    "helpers:pinGitHubActionDigests",
    ":semanticPrefixFixDepsChoreOthers",
    ":dependencyDashboard",
  ],

  // Added for posterity how to let Renovate manage version-branches, assuming that release branches
  // have the `release/` prefix.
  // BE CAREFUL WITH THIS OPTION and make sure that the changes work.
  baseBranchPatterns: [
    "main",
  ],

  dockerfile: {
    // Update all dockerfiles
    "ignorePaths": []
  },

  customManagers: [
    {
      customType: "regex",
      fileMatch: ["^\\.github/workflows/.+\\.ya?ml$"],
      matchStrings: [
        "BUILDISH_RELEASE_TOOLING_REF: (?<currentDigest>[a-f0-9]{40}) # renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)(?: versioning=(?<versioning>.+?))? currentValue=(?<currentValue>.+?)\\s",
      ],
      matchStringsStrategy: "any",
    },
  ],

  packageRules: [
    // Check for updates, do not merge automatically. This rule does effectively nothing, but serves as a
    // reference for the kinds of managers used in Polaris.
    {
      matchManagers: [
        "gradle",
        "gradle-wrapper",
        "nvm",
        "npm",
        "dockerfile",
        "devcontainer",
        "docker-compose",
        "pip_requirements",
        "pip_setup",
        "poetry",
        "setup-cfg",
        "github-actions",
      ],
      automerge: false, // just be explicit (false is the default)
    },
    // NPM dependencies
    {
      "matchDatasources": [
        "npm",
      ],
      // 3 days should be the minimum, because a release can be unpublished within the first 72 hours.
      "minimumReleaseAge": "7 days"
    },
    // Python dependencies
    {
      "matchDatasources": [
        "pip_requirements",
        "pip_setup",
        "poetry",
        "setup-cfg",
      ],
      // 3 days should be the minimum
      "minimumReleaseAge": "3 days"
    },
  ],

  // Max 50 PRs in total, 5 per hour.
  // Renovate rebases PRs automatically when the renovate bot "visits" (scans) the repo, hence the hourly and
  // concurrent PRs limit.
  prConcurrentLimit: 50,
  prHourlyLimit: 5,
}
